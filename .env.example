# =============================================================================
# ThreadLore Environment Configuration Template
# =============================================================================

# Google Cloud Platform & Vertex AI Configuration (Cloud Run / Production)
PROJECT_ID=threadlore-2026
LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Local Development Alternative (Google AI Studio API Key)
# If provided, the backend connects directly to Google AI Studio instead of Vertex AI:
# GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Storage
GCS_BUCKET_NAME=threadlore-swatches-2026

# Server & Security
PORT=8080
MAX_UPLOAD_SIZE_BYTES=2097152

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
